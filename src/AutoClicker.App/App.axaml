<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AutoClicker.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
             <!-- MainWindow.axaml.cs overrides this at startup from the saved AppSettings.Theme, and
                  MainWindowViewModel updates it live when the user picks Auto/Light/Dark in the toolbar. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AutoClicker.App/Styles/AppTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AutoClicker.App/Styles/AppControls.axaml" />
    </Application.Styles>
</Application>