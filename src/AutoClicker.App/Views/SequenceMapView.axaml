<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AutoClicker.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="230"
             x:Class="AutoClicker.App.Views.SequenceMapView"
             x:DataType="vm:ProfileEditorViewModel"
             x:Name="Root">
    <StackPanel Orientation="Horizontal" Spacing="14">
        <StackPanel Spacing="6">
            <CheckBox Content="Zobrazit reálný obsah obrazovky" IsChecked="{Binding ShowRealScreenshot}" />

            <Border BorderBrush="Gray" BorderThickness="1" Background="#0A000000" Width="380" Height="200" ClipToBounds="True">
                <Canvas Width="380" Height="200">
                    <ItemsControl ItemsSource="{Binding MapMonitorRects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MapMonitorRectViewModel">
                                <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                                           Width="{Binding Width}" Height="{Binding Height}"
                                           Stroke="Gray" StrokeThickness="1" Fill="Transparent" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Polyline Points="{Binding MapPolylinePoints}" Stroke="CornflowerBlue" StrokeThickness="1.5" />

                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SequenceStepViewModel">
                                <Button Canvas.Left="{Binding MapX}" Canvas.Top="{Binding MapY}"
                                        Width="18" Height="18" Padding="0" CornerRadius="9"
                                        Content="{Binding StepNumber}" FontSize="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Command="{Binding #Root.((vm:ProfileEditorViewModel)DataContext).SelectStepCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Border>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding ShowRealScreenshot}">
            <TextBlock Text="Detail vybraného bodu (2× přiblíženo)" FontSize="12" Opacity="0.8" />
            <Border BorderBrush="Gray" BorderThickness="1" Width="440" Height="280" ClipToBounds="True">
                <Panel>
                    <Image Source="{Binding DetailBitmap}" Width="440" Height="280" Stretch="Fill"
                           IsVisible="{Binding DetailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="Vyber bod v mapě nebo časové ose"
                               IsVisible="{Binding DetailBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap" MaxWidth="300" />
                    <!-- Střed cílového bodu vyznačen křížkem uprostřed výřezu -->
                    <Line StartPoint="210,140" EndPoint="230,140" Stroke="Red" StrokeThickness="1.5"
                          IsVisible="{Binding DetailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Line StartPoint="220,130" EndPoint="220,150" Stroke="Red" StrokeThickness="1.5"
                          IsVisible="{Binding DetailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Panel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
