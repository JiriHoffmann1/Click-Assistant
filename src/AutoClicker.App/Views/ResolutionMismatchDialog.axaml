<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoClicker.App.Views.ResolutionMismatchDialog"
        Title="Změna rozlišení obrazovky"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock TextWrapping="Wrap"
                    Text="Rozlišení obrazovky se od nadefinování bodů změnilo. Body tak nemusí mířit na správné místo." />
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
        <StackPanel Spacing="8">
            <Button Content="Přepočítat body poměrem" HorizontalAlignment="Stretch" Click="OnRescaleClick" />
            <Button Content="Pokračovat i tak (na vlastní riziko)" HorizontalAlignment="Stretch" Click="OnContinueClick" />
            <Button Content="Zrušit a předefinovat body ručně" HorizontalAlignment="Stretch" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
