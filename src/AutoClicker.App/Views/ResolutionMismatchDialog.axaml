<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AutoClicker.App.Localization"
        x:Class="AutoClicker.App.Views.ResolutionMismatchDialog"
        Title="{loc:Tr resolutionDialog.title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock TextWrapping="Wrap"
                    Text="{loc:Tr resolutionDialog.message}" />
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
        <StackPanel Spacing="8">
            <Button Content="{loc:Tr resolutionDialog.rescale}" HorizontalAlignment="Stretch" Click="OnRescaleClick" />
            <Button Content="{loc:Tr resolutionDialog.continue}" HorizontalAlignment="Stretch" Click="OnContinueClick" />
            <Button Content="{loc:Tr resolutionDialog.cancel}" HorizontalAlignment="Stretch" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
