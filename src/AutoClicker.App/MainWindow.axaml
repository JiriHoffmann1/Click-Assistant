<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AutoClicker.App.ViewModels"
        xmlns:views="using:AutoClicker.App.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="AutoClicker.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AutoClicker"
        Width="900" Height="600">

    <Grid ColumnDefinitions="220,*" Margin="14">
        <!-- Seznam profilů -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Profily" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                <Button Content="Nový" Command="{Binding NewProfileCommand}" />
                <Button Content="Smazat" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Editor profilu + ovládání -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                <Button Content="Uložit profil" Command="{Binding SaveProfileCommand}" />
                <Button Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding !IsRunning}" />
                <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="10" DataContext="{Binding Editor}" x:DataType="vm:ProfileEditorViewModel">
                <TextBox Text="{Binding Name}" Watermark="Název profilu" FontSize="16" FontWeight="Bold" />

                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pořadí:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding OrderMode}" ItemsSource="{Binding OrderModeValues}" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Opakování:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="3" SelectedItem="{Binding Repeat}" ItemsSource="{Binding RepeatModeValues}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Interval (ms):" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding BaseIntervalMs}" Minimum="10" Maximum="600000" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Jitter (± ms):" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding JitterMs}" Minimum="0" Maximum="60000" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Přidat bod" Command="{Binding AddPointCommand}" IsEnabled="{Binding !IsCapturingPoint}" />
                    <Button Content="Zrušit výběr bodu" Command="{Binding CancelCaptureCommand}" IsVisible="{Binding IsCapturingPoint}" />
                    <TextBlock Text="Klikni kamkoliv na obrazovku pro zachycení bodu…" VerticalAlignment="Center"
                               IsVisible="{Binding IsCapturingPoint}" FontStyle="Italic" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Globální zkratka start/stop:" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HotkeyDisplayText}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="Nastavit" Command="{Binding SetHotkeyCommand}" IsEnabled="{Binding !IsCapturingHotkey}" />
                    <Button Content="Zrušit" Command="{Binding CancelHotkeyCaptureCommand}" IsVisible="{Binding IsCapturingHotkey}" />
                    <TextBlock Text="Stiskni kombinaci kláves…" VerticalAlignment="Center"
                               IsVisible="{Binding IsCapturingHotkey}" FontStyle="Italic" />
                </StackPanel>

                <Expander Header="Humanizace (anti-detekční mód)">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <CheckBox Content="Zapnout humanizaci" IsChecked="{Binding HumanizationEnabled}" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8"
                              IsEnabled="{Binding HumanizationEnabled}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Rozptyl pozice (px):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding PositionJitterRadiusPx}" Minimum="0" Maximum="200" />

                            <CheckBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Content="Zakřivený pohyb kurzoru"
                                      IsChecked="{Binding UseCurvedMovement}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pohyb min (ms):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MovementDurationMsMin}" Minimum="10" Maximum="5000" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Pohyb max (ms):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding MovementDurationMsMax}" Minimum="10" Maximum="5000" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Prohnutí křivky (%):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding CurveBowStrengthPercent}" Minimum="0" Maximum="100" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Šance na 'overshoot' (%):" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding OvershootChancePercent}" Minimum="0" Maximum="100" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Border Height="1" Background="Gray" Margin="0,4" />
            </StackPanel>

            <views:SequenceMapView DockPanel.Dock="Top" DataContext="{Binding Editor}" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <views:SequenceTimelineView DataContext="{Binding Editor}" />
        </DockPanel>
    </Grid>
</Window>
