<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ClickAssistant.App.ViewModels"
        xmlns:views="using:ClickAssistant.App.Views"
        xmlns:loc="using:ClickAssistant.App.Localization"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
        x:Class="ClickAssistant.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr app.title}"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Width="960" Height="640" MinWidth="900" MinHeight="560"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="34">

    <Grid RowDefinitions="Auto,*">
        <!-- Custom brass title bar: the OS keeps drawing the min/max/close buttons
             (PreferSystemChrome), we draw everything left of them ourselves so the
             accent color actually reaches the strip the window title lives in. -->
        <Border Grid.Row="0" Height="34" Background="{DynamicResource ThemeTitleBarBrush}"
                PointerPressed="TitleBar_PointerPressed">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="22" Height="22" />
                <TextBlock Text="{loc:Tr app.title}" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{DynamicResource ThemeTitleBarInkBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="14">
        <!-- Seznam profilů -->
        <DockPanel Grid.Column="0" MinWidth="180" MaxWidth="320" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr profiles.header}" Classes="cardTitle" Margin="4,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                <Button Content="{loc:Tr profiles.new}" Command="{Binding NewProfileCommand}" Classes="ghost" ToolTip.Tip="{loc:Tr profiles.new.tooltip}" />
                <Button Content="{loc:Tr toolbar.save}" Command="{Binding SaveProfileCommand}" ToolTip.Tip="{loc:Tr toolbar.save.tooltip}" />
                <Button Content="{loc:Tr profiles.delete}" Command="{Binding DeleteProfileCommand}" Classes="ghost" ToolTip.Tip="{loc:Tr profiles.delete.tooltip}" />
            </StackPanel>
            <ListBox Classes="profiles" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Editor profilu + ovládání -->
        <DockPanel Grid.Column="1">
            <!-- Horní lišta: akce, stav běhu, jazyk, motiv. Docked outside the ScrollViewer
                 so it stays pinned at the top instead of scrolling away with the editor content. -->
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                <!-- Border wraps each Button so the tooltip still shows while the Button itself is disabled
                     (Avalonia does not raise pointer/tooltip events on a disabled control). -->
                <Border Background="Transparent" ToolTip.Tip="{loc:Tr toolbar.start.tooltip}" Margin="0,0,8,6">
                    <Button Content="{loc:Tr toolbar.start}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Classes="primary" />
                </Border>
                <Border Background="Transparent" ToolTip.Tip="{loc:Tr toolbar.stop.tooltip}" Margin="0,0,14,6">
                    <Button Content="{loc:Tr toolbar.stop}" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Classes="danger" />
                </Border>

                <Border Classes="statusPill" Margin="0,0,14,6">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Classes="statusDot" Classes.running="{Binding IsRunning}" VerticalAlignment="Center" />
                        <TextBlock Classes="statusText" Classes.running="{Binding IsRunning}" Text="{Binding StatusText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                          ToolTip.Tip="{loc:Tr language.tooltip}" Margin="0,0,8,6">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Flag}" FontSize="16" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding NativeName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ListBox Classes="segmented" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                          ToolTip.Tip="{loc:Tr theme.tooltip}" Margin="0,0,0,6" VerticalAlignment="Center">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </WrapPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="12" DataContext="{Binding Editor}" x:DataType="vm:ProfileEditorViewModel">
                <TextBox Text="{Binding Name}" Watermark="{loc:Tr editor.name.watermark}" ToolTip.Tip="{loc:Tr editor.name.tooltip}" FontSize="16" FontWeight="Bold" />

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Tr editor.timingCard.header}" Classes="cardTitle" Margin="0" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr editor.order.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr editor.order.tooltip}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding OrderMode}" ItemsSource="{Binding OrderModeValues}" ToolTip.Tip="{loc:Tr editor.order.tooltip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static loc:EnumTranslationConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr editor.repeat.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr editor.repeat.tooltip}" />
                            <ComboBox Grid.Row="0" Grid.Column="3" SelectedItem="{Binding Repeat}" ItemsSource="{Binding RepeatModeValues}" ToolTip.Tip="{loc:Tr editor.repeat.tooltip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static loc:EnumTranslationConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr editor.interval.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr editor.interval.tooltip}" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding BaseIntervalMs}" Minimum="10" Maximum="600000" ToolTip.Tip="{loc:Tr editor.interval.tooltip}" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr editor.jitter.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr editor.jitter.tooltip}" />
                            <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding JitterMs}" Minimum="0" Maximum="60000" ToolTip.Tip="{loc:Tr editor.jitter.tooltip}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr editor.addPoint}" Command="{Binding AddPointCommand}" IsEnabled="{Binding !IsCapturingPoint}" Classes="primary" ToolTip.Tip="{loc:Tr editor.addPoint.tooltip}" Margin="0,0,10,6" />
                    <Button Content="{loc:Tr editor.cancelCapture}" Command="{Binding CancelCaptureCommand}" IsVisible="{Binding IsCapturingPoint}" Classes="ghost" Margin="0,0,10,6" />
                    <Button Content="{loc:Tr editor.addKeyStep}" Command="{Binding AddKeyStepCommand}" Classes="ghost" ToolTip.Tip="{loc:Tr editor.addKeyStep.tooltip}" Margin="0,0,10,6" />
                    <TextBlock Text="{loc:Tr editor.capturingPoint.hint}" VerticalAlignment="Center" Margin="0,0,10,6"
                               IsVisible="{Binding IsCapturingPoint}" FontStyle="Italic" Foreground="{DynamicResource ThemeInkDimBrush}" />
                </WrapPanel>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Tr hotkeys.header}" Classes="cardTitle" Margin="0" />
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr hotkey.start.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr hotkey.start.tooltip}" Margin="0,0,10,6" Classes="fieldLabel" />
                            <TextBlock Text="{Binding HotkeyDisplayText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,6" />
                            <Button Content="{loc:Tr hotkey.set}" Command="{Binding SetHotkeyCommand}" IsEnabled="{Binding !IsCapturingHotkey}" Classes="ghost" Margin="0,0,10,6" />
                            <Button Content="{loc:Tr hotkey.cancel}" Command="{Binding CancelHotkeyCaptureCommand}" IsVisible="{Binding IsCapturingHotkey}" Classes="ghost" Margin="0,0,10,6" />
                            <TextBlock Text="{loc:Tr hotkey.capturing.hint}" VerticalAlignment="Center" Margin="0,0,10,6"
                                       IsVisible="{Binding IsCapturingHotkey}" FontStyle="Italic" Foreground="{DynamicResource ThemeInkDimBrush}" />
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr hotkey.stop.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr hotkey.stop.tooltip}" Margin="0,0,10,6" Classes="fieldLabel" />
                            <TextBlock Text="{Binding StopHotkeyDisplayText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,6" />
                            <Button Content="{loc:Tr hotkey.set}" Command="{Binding SetStopHotkeyCommand}" IsEnabled="{Binding !IsCapturingStopHotkey}" Classes="ghost" Margin="0,0,10,6" />
                            <Button Content="{loc:Tr hotkey.cancel}" Command="{Binding CancelStopHotkeyCaptureCommand}" IsVisible="{Binding IsCapturingStopHotkey}" Classes="ghost" Margin="0,0,10,6" />
                            <TextBlock Text="{loc:Tr hotkey.capturing.hint}" VerticalAlignment="Center" Margin="0,0,10,6"
                                       IsVisible="{Binding IsCapturingStopHotkey}" FontStyle="Italic" Foreground="{DynamicResource ThemeInkDimBrush}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Expander Header="{loc:Tr humanization.header}" ToolTip.Tip="{loc:Tr humanization.header.tooltip}">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <CheckBox Content="{loc:Tr humanization.enabled}" IsChecked="{Binding HumanizationEnabled}" ToolTip.Tip="{loc:Tr humanization.enabled.tooltip}" />
                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8"
                              IsEnabled="{Binding HumanizationEnabled}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr humanization.positionJitter.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr humanization.positionJitter.tooltip}" />
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding PositionJitterRadiusPx}" Minimum="0" Maximum="200" ToolTip.Tip="{loc:Tr humanization.positionJitter.tooltip}" />

                            <CheckBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Content="{loc:Tr humanization.curvedMovement}"
                                      IsChecked="{Binding UseCurvedMovement}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr humanization.curvedMovement.tooltip}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr humanization.durationMin.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr humanization.durationMin.tooltip}" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MovementDurationMsMin}" Minimum="10" Maximum="5000" ToolTip.Tip="{loc:Tr humanization.durationMin.tooltip}" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr humanization.durationMax.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr humanization.durationMax.tooltip}" />
                            <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding MovementDurationMsMax}" Minimum="10" Maximum="5000" ToolTip.Tip="{loc:Tr humanization.durationMax.tooltip}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr humanization.curveBow.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr humanization.curveBow.tooltip}" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding CurveBowStrengthPercent}" Minimum="0" Maximum="100" ToolTip.Tip="{loc:Tr humanization.curveBow.tooltip}" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Tr humanization.overshoot.label}" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr humanization.overshoot.tooltip}" />
                            <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding OvershootChancePercent}" Minimum="0" Maximum="100" ToolTip.Tip="{loc:Tr humanization.overshoot.tooltip}" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- Mapa bodů a časová osa vedle sebe (dle schváleného vizuálního směru) -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,14,0,0">
                <views:SequenceMapView Grid.Column="0" DataContext="{Binding Editor}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,0" />
                <views:SequenceTimelineView Grid.Column="1" DataContext="{Binding Editor}" VerticalAlignment="Top" />
            </Grid>
            </DockPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
