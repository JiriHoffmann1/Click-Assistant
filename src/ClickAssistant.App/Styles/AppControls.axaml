<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control restyle on top of FluentTheme, driven entirely by the DynamicResource palette in
    AppTheme.axaml so every control here follows Light/Dark/Auto automatically. FluentTheme's
    built-in control templates bind Background/BorderBrush/Foreground/CornerRadius from
    TemplateBinding, so overriding those properties at the Style level reskins reliably without
    needing to replace whole ControlTemplates.
  -->

  <!-- ===================== Buttons ===================== -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentContrastBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeDangerBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeBadBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
  </Style>

  <!-- ===================== Text input ===================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
  </Style>

  <!-- ===================== NumericUpDown ===================== -->
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <!-- RepeatButton derives from Button, so the generic Button style above (its own Background/
       BorderBrush/BorderThickness/CornerRadius) was also landing on the up/down spinner buttons
       inside NumericUpDown's template. Fluent's own template only rounds the NumericUpDown's
       root border on the text-box side and leaves the spinner side square, relying on
       PART_IncreaseButton/PART_DecreaseButton to each round just their own outer corner - our
       generic Button style was overriding that with a uniform CornerRadius on all four corners
       of each tiny button, which broke the curve where it meets the root border (looked like a
       chunk of the rounded edge next to the down-arrow was missing). Give the spinner buttons a
       transparent, borderless surface again, but restore the single-corner rounding so the right
       edge reads as one continuous rounded rectangle. -->
  <Style Selector="NumericUpDown /template/ RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="NumericUpDown /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="CornerRadius" Value="0,7,0,0" />
  </Style>
  <Style Selector="NumericUpDown /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="CornerRadius" Value="0,0,7,0" />
  </Style>
  <Style Selector="NumericUpDown /template/ RepeatButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
  </Style>

  <!-- ===================== ComboBox ===================== -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <!-- Matches ComboBox's own content Padding above, so the popup's item text lines up under the
         text shown in the closed box instead of starting at a different left offset. -->
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource ThemeAccentContrastBrush}" />
  </Style>
  <!-- Best-effort: FluentTheme's own resource key for the ComboBox popup surface. If the exact
       key differs across Avalonia point releases, the popup still falls back to Fluent's own
       theme-appropriate (dark-in-dark / light-in-light) default - never unreadable, just not
       pixel-matched to the rest of the app. -->
  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
  </Style>

  <!-- ===================== CheckBox / ToggleSwitch ===================== -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
  </Style>
  <Style Selector="ToggleSwitch /template/ Border#OuterBorder">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#OuterBorder">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
  </Style>

  <!-- ===================== Expander (Humanization card) ===================== -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#PART_toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Expander /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
    <Setter Property="Padding" Value="16,0,16,14" />
  </Style>

  <!-- ===================== Profile list / segmented theme picker ===================== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkDimBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,9" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Profiles list specifically: the selected profile gets the brass accent (a border, not a
       full accent fill - a solid accent-filled row read as too heavy at this width), on top of
       the shared selected/hover styling above. -->
  <Style Selector="ListBox.profiles ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="ListBox.profiles ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentInkBrush}" />
  </Style>

  <!-- Segmented Auto/Light/Dark theme picker: a ListBox rendered as a row of pill buttons. -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkDimBrush}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentContrastBrush}" />
  </Style>

  <!-- ===================== Cards ===================== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="Border.card.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkDimBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkDimBrush}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Status pill (Idle/Running readout next to Start/Stop) -->
  <Style Selector="Border.statusPill">
    <Setter Property="Background" Value="{DynamicResource ThemeSurface2Brush}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Ellipse.statusDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource ThemeInkDimBrush}" />
  </Style>
  <Style Selector="Ellipse.statusDot.running">
    <Setter Property="Fill" Value="{DynamicResource ThemeGoodBrush}" />
  </Style>
  <Style Selector="TextBlock.statusText">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource ThemeInkDimBrush}" />
  </Style>
  <Style Selector="TextBlock.statusText.running">
    <Setter Property="Foreground" Value="{DynamicResource ThemeGoodBrush}" />
  </Style>

  <!-- Monitor rect in the sequence map: tinted fill so it reads clearly against the map background,
       and strongly highlighted with a bold accent-colored border when the user has focused it via click.
       Focused state deliberately keeps the same subtle fill as the base state (not a solid accent fill) -
       a fully opaque accent fill made the whole rectangle read as a solid purple block. -->
  <Style Selector="Rectangle.monitorRect">
    <Setter Property="Stroke" Value="{DynamicResource ThemeInkDimBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Fill" Value="{DynamicResource ThemeBorderBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Rectangle.monitorRect.focused">
    <Setter Property="Stroke" Value="{DynamicResource ThemeAccentBrush}" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="Opacity" Value="1" />
  </Style>

</Styles>
