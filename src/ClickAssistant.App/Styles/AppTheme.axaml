<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Custom colour palette for the whole app, replacing FluentTheme's default blue palette.
    "Brass" family in both variants (warm antique gold accent on warm neutrals, not a straight
    invert) so Light doesn't feel like a different app - see technicalExplanation.md for the
    design rationale. Avalonia picks the matching dictionary below automatically based on
    ActualThemeVariant, and every DynamicResource lookup re-resolves live when
    RequestedThemeVariant changes.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#17151A" />
      <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#1E1A1F" />
      <SolidColorBrush x:Key="ThemeSurface2Brush" Color="#2A242B" />
      <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3A3239" />
      <SolidColorBrush x:Key="ThemeInkBrush" Color="#ECE6DA" />
      <SolidColorBrush x:Key="ThemeInkDimBrush" Color="#A79C8C" />
      <SolidColorBrush x:Key="ThemeAccentBrush" Color="#D3A94B" />
      <SolidColorBrush x:Key="ThemeAccentContrastBrush" Color="#221A0E" />
      <SolidColorBrush x:Key="ThemeAccentInkBrush" Color="#E9C878" />
      <!-- Muted, not the full bright accent - sits right at the top of a near-black window,
           so it needs to read as "brass" without fighting the dark content underneath it. -->
      <SolidColorBrush x:Key="ThemeTitleBarBrush" Color="#3C331F" />
      <SolidColorBrush x:Key="ThemeGoodBrush" Color="#7CBF8E" />
      <SolidColorBrush x:Key="ThemeBadBrush" Color="#D98F7A" />
      <SolidColorBrush x:Key="ThemeDangerBorderBrush" Color="#3D2E28" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F2ECE0" />
      <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FBF7EE" />
      <SolidColorBrush x:Key="ThemeSurface2Brush" Color="#EAE0CB" />
      <SolidColorBrush x:Key="ThemeBorderBrush" Color="#DBCBA6" />
      <SolidColorBrush x:Key="ThemeInkBrush" Color="#362D1F" />
      <SolidColorBrush x:Key="ThemeInkDimBrush" Color="#7C7060" />
      <SolidColorBrush x:Key="ThemeAccentBrush" Color="#9C7A2E" />
      <SolidColorBrush x:Key="ThemeAccentContrastBrush" Color="#FBF3E2" />
      <SolidColorBrush x:Key="ThemeAccentInkBrush" Color="#7C5A1E" />
      <!-- Same idea as Dark's: softened toward the parchment background instead of the full
           saturated accent, so the bar reads as part of the same surface family. -->
      <SolidColorBrush x:Key="ThemeTitleBarBrush" Color="#D9C69A" />
      <SolidColorBrush x:Key="ThemeGoodBrush" Color="#4F8F63" />
      <SolidColorBrush x:Key="ThemeBadBrush" Color="#B06A4E" />
      <SolidColorBrush x:Key="ThemeDangerBorderBrush" Color="#E8DAC4" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
