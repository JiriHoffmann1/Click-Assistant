<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ClickAssistant.App.Localization"
        x:Class="ClickAssistant.App.Views.ResolutionMismatchDialog"
        Title="{loc:Tr resolutionDialog.title}"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ThemeInkBrush}"
                    Text="{loc:Tr resolutionDialog.message}" />
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeInkDimBrush}" />
        <StackPanel Spacing="8">
            <Button Content="{loc:Tr resolutionDialog.rescale}" Classes="primary" HorizontalAlignment="Stretch" Click="OnRescaleClick" />
            <Button Content="{loc:Tr resolutionDialog.continue}" Classes="ghost" HorizontalAlignment="Stretch" Click="OnContinueClick" />
            <Button Content="{loc:Tr resolutionDialog.cancel}" Classes="danger" HorizontalAlignment="Stretch" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
