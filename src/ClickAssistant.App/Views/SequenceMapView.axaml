<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ClickAssistant.App.ViewModels"
             xmlns:loc="using:ClickAssistant.App.Localization"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="230"
             x:Class="ClickAssistant.App.Views.SequenceMapView"
             x:DataType="vm:ProfileEditorViewModel"
             x:Name="Root">
    <WrapPanel Orientation="Horizontal">
        <Border Classes="card" Margin="0,0,14,10">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox Content="{loc:Tr map.showScreenshot}" IsChecked="{Binding ShowRealScreenshot}" ToolTip.Tip="{loc:Tr map.showScreenshot.tooltip}" />
                <Button Content="{loc:Tr map.identify}" Command="{Binding IdentifyMonitorsCommand}" Classes="ghost" Padding="10,4" ToolTip.Tip="{loc:Tr map.identify.tooltip}" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Background="{DynamicResource ThemeSurface2Brush}" Width="{Binding MapWidth}" Height="{Binding MapHeight}" ClipToBounds="True">
                <Canvas Width="{Binding MapWidth}" Height="{Binding MapHeight}">
                    <!-- Obdélníky monitorů se spravují ručně v code-behind (MonitorRectsHost.Children), ne přes
                         ItemsControl/DataTemplate - Avalonia u tohoto ItemsControlu+Canvas+ObservableCollection
                         spolehlivě špatně vykreslovala více položek najednou (kontejnery si popletly pozici a
                         velikost mezi sebou), zatímco ruční správa Canvas dětí funguje bez problémů. -->
                    <Canvas x:Name="MonitorRectsHost" Width="{Binding MapWidth}" Height="{Binding MapHeight}" />

                    <Polyline Points="{Binding MapPolylinePoints}" Stroke="{DynamicResource ThemeAccentBrush}"
                              StrokeThickness="2.5" StrokeJoin="Round" StrokeLineCap="Round" Opacity="0.9" />

                    <!-- Tečky bodů sekvence se stejně jako obdélníky monitorů spravují ručně v code-behind
                         (StepsHost.Children) - viz komentář u MonitorRectsHost výše, stejná Avalonia chyba
                         postihuje i tento ItemsControl s 2+ položkami. -->
                    <Canvas x:Name="StepsHost" Width="{Binding MapWidth}" Height="{Binding MapHeight}" />
                </Canvas>
            </Border>
        </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding ShowRealScreenshot}">
        <StackPanel Spacing="8">
            <TextBlock Text="{loc:Tr map.detailTitle}" Classes="fieldLabel" />
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Width="440" Height="280" ClipToBounds="True">
                <Panel>
                    <Image Source="{Binding DetailBitmap}" Width="440" Height="280" Stretch="Fill"
                           IsVisible="{Binding DetailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{loc:Tr map.detailPlaceholder}"
                               IsVisible="{Binding DetailBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                               Foreground="{DynamicResource ThemeInkDimBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
                    <!-- Kroužek znázorňuje oblast náhodné odchylky (Humanization.PositionJitterRadiusPx) kolem bodu -->
                    <Ellipse Width="{Binding DetailJitterDisplayDiameter}" Height="{Binding DetailJitterDisplayDiameter}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="Red" StrokeThickness="1.5" StrokeDashArray="4,3" Opacity="0.8"
                             IsVisible="{Binding ShowJitterCircle}" />

                    <!-- Střed cílového bodu vyznačen křížkem uprostřed výřezu -->
                    <Line StartPoint="210,140" EndPoint="230,140" Stroke="Red" StrokeThickness="1.5"
                          IsVisible="{Binding DetailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Line StartPoint="220,130" EndPoint="220,150" Stroke="Red" StrokeThickness="1.5"
                          IsVisible="{Binding DetailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Panel>
            </Border>
        </StackPanel>
        </Border>
    </WrapPanel>
</UserControl>
